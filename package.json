{
  "name": "pcap-to-osi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A browser-based teaching tool that dissects packet captures into the seven OSI layers, byte by byte, with plain-English explanations of every header field.",
  "license": "MIT",
  "homepage": "https://michaelaperry.github.io/pcaptoOSI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelAPerry/pcaptoOSI.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelAPerry/pcaptoOSI/issues"
  },
  "keywords": [
    "pcap",
    "pcapng",
    "osi-model",
    "networking",
    "packet-analysis",
    "wireshark",
    "education",
    "teaching",
    "radiotap",
    "802.11"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vite build --ssr tests/harness.ts --outDir node_modules/.test --logLevel warn && node node_modules/.test/harness.js",
    "samples": "node tools/gen-samples.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "build:single": "npm run build && node tools/build-single.mjs",
    "build:artifact": "npm run build && node tools/build-artifact.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
